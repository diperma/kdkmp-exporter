# Origin allowed to call this API (the GitHub Pages URL). Comma-separated for several.
# Example: https://<user>.github.io
ALLOWED_ORIGINS=http://localhost:5173

# Vercel KV (Upstash Redis). Provisioned automatically when you add the KV/Upstash
# integration to the Vercel project — these names are what Vercel injects.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash QStash — background job queue for the multi-province report.
QSTASH_TOKEN=

# Public base URL of THIS backend, used as the QStash callback target.
# Example: https://kdkmp-exporter.vercel.app
PUBLIC_BASE_URL=
